# Auto detect text files and check them out with LF unless overridden below.
* text=auto eol=lf

# Source and configuration files should be checked out with LF endings.
*.dart text eol=lf
*.gradle text eol=lf
*.html text eol=lf
*.java text eol=lf
*.json text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.plist text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.swift text eol=lf
*.ts text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Podfile text eol=lf
Podfile.lock text eol=lf
pubspec.lock text eol=lf

# Windows project and script files should keep CRLF endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.rc text eol=crlf
*.sln text eol=crlf
*.props text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf

# Binary assets and packages should never be line-normalized.
*.ico binary
*.jar binary
*.jpg binary
*.jpeg binary
*.keystore binary
*.jks binary
*.p12 binary
*.pfx binary
*.png binary
*.webp binary
*.zip binary
